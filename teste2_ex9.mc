int main() {
    int a, b, c, d, e, f, g, h;
    int x, y, z, w;
    int i, j, k;

    a = 5;
    b = 10;

    c = 0 + 0;
    d = c - 0;
    e = a * 1;
    f = 1 * b;
    g = e + f;
    h = e + f;

    i = 2;
    j = i * 0;
    k = j / 1;

    x = a + b;
    y = a + b;

    if (a < b) {
        z = a + b;
        w = a + b;
    } else {
        a = 7;
        z = a + b;
        w = a + b;
    }

    a = 3;
    b = 4;

    x = a + b;
    y = a + b;

    while (a < 10) {
        c = a * 1;
        d = 0 + c;
        e = c + 0;
        a = a + 1;
    }

    return 0;
}
